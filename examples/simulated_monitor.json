{
  "format": "pylabview-project",
  "version": 2,
  "name": "Simulated Monitor",
  "main_vi": "main",
  "vis": [{
    "id": "main",
    "name": "Main VI",
    "graph": {
      "name": "Main VI",
      "nodes": [
        {"id": "analog1", "type": "analog_input", "x": 80, "y": 80, "label": "Sensor Suhu Simulasi", "properties": {"driver": "simulated", "channel": "AI0", "minimum": 18.0, "maximum": 32.0}},
        {"id": "chart1", "type": "chart", "x": 360, "y": 55, "label": "Riwayat Suhu", "properties": {"history": 120, "display_type": "waveform_chart", "style": "default"}},
        {"id": "display1", "type": "display", "x": 360, "y": 180, "label": "Suhu Saat Ini", "properties": {"display_type": "thermometer", "style": "default"}},
        {"id": "log1", "type": "log", "x": 360, "y": 300, "label": "Log Sensor", "properties": {"prefix": "Suhu: "}}
      ],
      "wires": [
        {"source_node": "analog1", "source_port": "out", "target_node": "chart1", "target_port": "value", "data_type": "numeric"},
        {"source_node": "analog1", "source_port": "out", "target_node": "display1", "target_port": "value", "data_type": "numeric"},
        {"source_node": "analog1", "source_port": "out", "target_node": "log1", "target_port": "value", "data_type": "numeric"}
      ]
    },
    "connector_pane": {"inputs": [], "outputs": []},
    "front_panel": {"title": "Monitor Suhu", "layout": {}}
  }]
}
